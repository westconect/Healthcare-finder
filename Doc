    <h1>Healthcare Finder</h1>

    <p>
      Find doctors and optometrists near you.
      Use your location or enter a place manually.
    </p>

    <div id="status"></div>

    <button onclick="findHealthcare('doctor')">
      🩺 Find a Doctor
    </button>

    <button class="optometrist" onclick="findHealthcare('optometrist')">
      👁️ Find an Optometrist
    </button>

    <div class="manual">

      <h3>Search another area</h3>

      <input
        type="text"
        id="locationInput"
        placeholder="Example: Bloemfontein"
      >

      <button onclick="manualSearch('doctor')">
        🩺 Doctors in this area
      </button>

      <button class="optometrist" onclick="manualSearch('optometrist')">
        👁️ Optometrists in this area
      </button>

    </div>

    <p class="small">
      Healthcare Finder — Version 1.0
    </p>

  </div>

  <script>

    function findHealthcare(type) {

      const status = document.getElementById("status");

      status.innerText = "📍 Getting your location...";

      if (!navigator.geolocation) {

        status.innerText =
          "Location is not supported. Please enter an area below.";

        return;
      }

      navigator.geolocation.getCurrentPosition(

        function(position) {

          const latitude = position.coords.latitude;
          const longitude = position.coords.longitude;

          let search;

          if (type === "doctor") {
            search = "doctor";
          } else {
            search = "optometrist";
          }

          const mapsURL =
            "https://www.google.com/maps/search/" +
            encodeURIComponent(search) +
            "/@" +
            latitude +
            "," +
            longitude +
            ",14z";

          status.innerText = "✅ Opening healthcare providers near you...";

          window.location.href = mapsURL;
        },

        function(error) {

          status.innerText =
            "📍 Location was not available. Enter your area below.";
        }

      );
    }


    function manualSearch(type) {

      const location =
        document.getElementById("locationInput").value.trim();

      if (location === "") {

        alert("Please enter a town, city or area.");

        return;
      }

      let search;

      if (type === "doctor") {

        search = "doctors near " + location;

      } else {

        search = "optometrists near " + location;

      }

      const mapsURL =
        "https://www.google.com/maps/search/" +
        encodeURIComponent(search);

      window.location.href = mapsURL;
    }

  </script>

